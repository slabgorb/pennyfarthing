---
/**
 * ThemeGrid Component
 *
 * Vertical list container for wide theme cards.
 * Uses Tailwind CSS for mobile-first responsive layout.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'theme-grid',
    'flex',
    'flex-col',
    'gap-4',
    className,
  ]}
>
  <slot />
</div>
