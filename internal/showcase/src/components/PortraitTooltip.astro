---
/**
 * PortraitTooltip Component
 *
 * Hover tooltip for character portraits in ThemeCard.
 * Shows character details without nested links (safe inside <a> tags).
 */

import type { Agent } from '../lib/types';

interface Props {
  agent: Agent;
  themeName: string;
  themeId: string;
}

const { agent, themeName, themeId } = Astro.props;

// Format role for display
const roleDisplay: Record<string, string> = {
  'sm': 'Scrum Master',
  'tea': 'Test Engineer',
  'dev': 'Developer',
  'reviewer': 'Code Reviewer',
  'architect': 'Architect',
  'devops': 'DevOps',
  'pm': 'Product Manager',
  'tech-writer': 'Tech Writer',
  'ux-designer': 'UX Designer',
  'orchestrator': 'Orchestrator'
};

const roleName = roleDisplay[agent.role] || agent.role;
const portraitPath = `/portraits/${themeId}/medium/${agent.slug}.png`;
---

<div class="portrait-tooltip-wrapper group relative block flex-shrink-0">
  <slot />

  <div class="portrait-tooltip absolute left-1/2 -translate-x-1/2 bottom-full mb-2 z-50 w-72 hidden group-hover:block">
    <div class="bg-stone-900 border border-stone-600 rounded-lg shadow-xl p-3">
      <!-- Portrait and info -->
      <div class="flex gap-3 mb-2">
        <!-- Full size portrait -->
        <img
          src={portraitPath}
          alt={agent.character}
          class="w-24 h-24 rounded object-cover bg-stone-700 flex-shrink-0"
        />

        <div class="flex-1 min-w-0">
          <!-- Character name and role -->
          <div class="font-semibold text-amber-100 text-sm truncate">{agent.character}</div>
          <div class="text-xs text-stone-400 mb-2">{roleName}</div>

          <!-- OCEAN scores inline -->
          <div class="text-xs space-y-0.5">
            <div><span class="text-purple-400">O</span><span class="text-stone-500">:</span><span class="text-stone-300 ml-1">{agent.ocean.O}</span></div>
            <div><span class="text-blue-400">C</span><span class="text-stone-500">:</span><span class="text-stone-300 ml-1">{agent.ocean.C}</span></div>
            <div><span class="text-yellow-400">E</span><span class="text-stone-500">:</span><span class="text-stone-300 ml-1">{agent.ocean.E}</span></div>
            <div><span class="text-green-400">A</span><span class="text-stone-500">:</span><span class="text-stone-300 ml-1">{agent.ocean.A}</span></div>
            <div><span class="text-red-400">N</span><span class="text-stone-500">:</span><span class="text-stone-300 ml-1">{agent.ocean.N}</span></div>
          </div>
        </div>
      </div>

      <!-- Trait -->
      <div class="text-xs text-stone-300">
        <span class="text-amber-200">Trait:</span> {agent.trait}
      </div>

      <!-- Quote -->
      {agent.quote && (
        <div class="text-xs text-stone-400 italic border-l-2 border-amber-600/50 pl-2 mt-2 line-clamp-2">
          "{agent.quote}"
        </div>
      )}
    </div>

    <!-- Arrow pointing down -->
    <div class="absolute left-1/2 -translate-x-1/2 -bottom-2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-stone-600"></div>
  </div>
</div>

<style>
  .portrait-tooltip {
    display: none;
    pointer-events: none;
  }

  .portrait-tooltip-wrapper:hover .portrait-tooltip {
    display: block;
    pointer-events: auto;
  }
</style>
