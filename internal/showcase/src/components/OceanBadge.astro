---
/**
 * OceanBadge Component
 *
 * Visual bar representation of OCEAN personality scores.
 * Displays 5 rows with dimension label, progress bar, and numeric value.
 */

import type { OceanScores } from '../lib/types';

interface Props {
  ocean: OceanScores;
  className?: string;
}

const { ocean, className = '' } = Astro.props;

// Full dimension names for accessibility
const dimensionNames: Record<keyof OceanScores, string> = {
  O: 'Openness',
  C: 'Conscientiousness',
  E: 'Extraversion',
  A: 'Agreeableness',
  N: 'Neuroticism',
};

// Color classes for each dimension
const dimensionColors: Record<keyof OceanScores, string> = {
  O: 'bg-purple-500',
  C: 'bg-blue-500',
  E: 'bg-yellow-500',
  A: 'bg-green-500',
  N: 'bg-red-500',
};

const dimensions: (keyof OceanScores)[] = ['O', 'C', 'E', 'A', 'N'];
---

<div class={`ocean-badge space-y-2 ${className}`}>
  {dimensions.map((dim) => {
    const score = ocean[dim];
    const percentage = (score / 5) * 100;

    return (
      <div class="ocean-row flex items-center gap-3" key={dim}>
        <div class="dimension-label w-8 text-right">
          <span class="font-bold text-stone-300">{dim}</span>
        </div>

        <div class="bar-container flex-1 h-3 bg-stone-700 rounded-full overflow-hidden">
          <div
            class={`bar h-full rounded-full ${dimensionColors[dim]}`}
            style={`width: ${percentage}%`}
            role="progressbar"
            aria-valuenow={score}
            aria-valuemin={1}
            aria-valuemax={5}
            aria-label={`${dimensionNames[dim]}: ${score}`}
          />
        </div>

        <div class="score-value w-8 text-left">
          <span class="text-sm font-medium text-stone-300">{score.toFixed(1)}</span>
        </div>
      </div>
    );
  })}

  <div class="legend mt-3 pt-3 border-t border-stone-700">
    <div class="flex flex-wrap gap-2 text-xs text-stone-400">
      {dimensions.map((dim) => (
        <span class="flex items-center gap-1" key={dim}>
          <span class={`w-2 h-2 rounded-full ${dimensionColors[dim]}`} />
          {dimensionNames[dim]}
        </span>
      ))}
    </div>
  </div>
</div>
