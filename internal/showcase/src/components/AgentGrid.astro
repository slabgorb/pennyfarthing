---
/**
 * AgentGrid Component
 *
 * Responsive 2x5 grid container for agent ProfileCards.
 * Uses Tailwind CSS for mobile-first responsive layout.
 * 5 columns on desktop, 2-3 on tablet, 1-2 on mobile.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'agent-grid',
    'grid',
    'grid-cols-2',
    'sm:grid-cols-3',
    'md:grid-cols-4',
    'lg:grid-cols-5',
    'gap-4',
    className,
  ]}
>
  <slot />
</div>
