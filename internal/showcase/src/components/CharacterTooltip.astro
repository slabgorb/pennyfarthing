---
/**
 * CharacterTooltip Component
 *
 * Compact hover card showing character details with OCEAN visualization.
 * Used in benchmark tables to provide quick character context.
 */

import type { Agent } from '../lib/types';
import SpiderChart from './SpiderChart.astro';

interface Props {
  agent: Agent;
  themeId: string;
  themeName: string;
}

const { agent, themeId, themeName } = Astro.props;

// Format role for display
const roleDisplay: Record<string, string> = {
  'sm': 'Scrum Master',
  'tea': 'Test Engineer',
  'dev': 'Developer',
  'reviewer': 'Code Reviewer',
  'architect': 'Architect',
  'devops': 'DevOps',
  'pm': 'Product Manager',
  'tech-writer': 'Tech Writer',
  'ux-designer': 'UX Designer',
  'orchestrator': 'Orchestrator'
};

const roleName = roleDisplay[agent.role] || agent.role;
---

<div class="character-tooltip-wrapper group relative inline-block">
  <span class="cursor-help border-b border-dotted border-amber-400/50 hover:border-amber-400">
    <slot />
  </span>

  <div class="character-tooltip absolute left-0 bottom-full mb-2 z-50 hidden group-hover:block w-72">
    <div class="bg-stone-900 border border-stone-600 rounded-lg shadow-xl p-4">
      <!-- Header with emoji and name -->
      <div class="flex items-start gap-3 mb-3">
        {agent.emoji && (
          <span class="text-3xl">{agent.emoji}</span>
        )}
        <div class="flex-1 min-w-0">
          <div class="font-semibold text-amber-100 truncate">{agent.character}</div>
          <div class="text-xs text-stone-400">{roleName} &middot; {themeName}</div>
        </div>
      </div>

      <!-- Spider chart and OCEAN scores -->
      <div class="flex gap-3 mb-3">
        <div class="flex-shrink-0">
          <SpiderChart agents={[agent]} size={60} showLabels={false} />
        </div>
        <div class="flex-1 text-xs space-y-0.5">
          <div class="flex justify-between">
            <span class="text-purple-400">O</span>
            <span class="text-stone-300">{agent.ocean.O}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-blue-400">C</span>
            <span class="text-stone-300">{agent.ocean.C}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-yellow-400">E</span>
            <span class="text-stone-300">{agent.ocean.E}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-green-400">A</span>
            <span class="text-stone-300">{agent.ocean.A}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-red-400">N</span>
            <span class="text-stone-300">{agent.ocean.N}</span>
          </div>
        </div>
      </div>

      <!-- Trait -->
      <div class="text-xs text-stone-300 mb-2">
        <span class="text-amber-200">Trait:</span> {agent.trait}
      </div>

      <!-- Quote -->
      {agent.quote && (
        <div class="text-xs text-stone-400 italic border-l-2 border-amber-600/50 pl-2">
          "{agent.quote}"
        </div>
      )}

      <!-- Link to full profile -->
      <a
        href={`/characters/${themeId}/${agent.role}`}
        class="block mt-3 text-xs text-amber-500 hover:text-amber-400 text-center"
      >
        View full profile &rarr;
      </a>
    </div>

    <!-- Arrow pointing down -->
    <div class="absolute left-4 -bottom-2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-stone-600"></div>
  </div>
</div>

<style>
  .character-tooltip-wrapper:hover .character-tooltip {
    display: block;
  }

  /* Ensure tooltip doesn't get clipped */
  .character-tooltip {
    pointer-events: none;
  }

  .character-tooltip-wrapper:hover .character-tooltip {
    pointer-events: auto;
  }
</style>
