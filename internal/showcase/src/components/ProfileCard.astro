---
/**
 * ProfileCard Component
 *
 * Individual agent card for theme detail view.
 * Shows agent emoji/face, character name, spider chart, quote,
 * and links to the full profile page.
 * Entire card is clickable.
 */

import type { Agent } from '../lib/types';
import SpiderChart from './SpiderChart.astro';

interface Props {
  agent: Agent;
  themeId: string;
}

const { agent, themeId } = Astro.props;
---

<a
  href={`/characters/${themeId}/${agent.role}`}
  class="profile-card bg-stone-800 border border-stone-700 rounded-lg shadow-md hover:shadow-lg hover:border-amber-600 transition-all p-4 flex flex-col items-center text-center cursor-pointer"
>
  <!-- Agent portrait with emoji fallback -->
  <div class="face w-16 h-16 mb-2 flex items-center justify-center">
    <img
      src={`/portraits/${themeId}/small/${agent.slug}.png`}
      alt={agent.character}
      class="portrait w-full h-full object-cover rounded"
      loading="lazy"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='block'"
    />
    <span class="emoji-fallback text-4xl hidden">
      {agent.emoji || '👤'}
    </span>
  </div>

  <!-- Character name -->
  <h4 class="character text-sm font-semibold text-amber-100 mb-1">
    {agent.character}
  </h4>

  <!-- Role label -->
  <p class="role text-xs text-stone-400 uppercase tracking-wide mb-2">
    {agent.role}
  </p>

  <!-- Individual spider chart -->
  <div class="spider mb-2">
    <SpiderChart agents={[agent]} size={60} />
  </div>

  <!-- Quote -->
  <p class="quote text-xs text-stone-300 italic line-clamp-2">
    "{agent.quote}"
  </p>
</a>
