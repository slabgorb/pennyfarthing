---
/**
 * OCEAN Analysis Page
 *
 * Comprehensive analysis of how Big Five personality traits correlate
 * with benchmark performance across agent roles.
 */
import Base from '../../layouts/Base.astro';
import tiersData from '../../../public/theme-tiers.json';

// Helper to get theme link
function getThemeLink(themeId: string): string {
  return `/themes/${themeId}`;
}

// OCEAN trait colors
const traitColors: Record<string, { bg: string; text: string; label: string }> = {
  'O': { bg: 'bg-purple-500', text: 'text-purple-400', label: 'Openness' },
  'C': { bg: 'bg-blue-500', text: 'text-blue-400', label: 'Conscientiousness' },
  'E': { bg: 'bg-green-500', text: 'text-green-400', label: 'Extraversion' },
  'A': { bg: 'bg-yellow-500', text: 'text-yellow-400', label: 'Agreeableness' },
  'N': { bg: 'bg-red-500', text: 'text-red-400', label: 'Neuroticism' }
};

// Level colors
function getLevelColor(level: string): string {
  if (level === 'H') return 'bg-green-500/30 text-green-300 border-green-500/50';
  if (level === 'L') return 'bg-red-500/30 text-red-300 border-red-500/50';
  return 'bg-yellow-500/30 text-yellow-300 border-yellow-500/50';
}

const ocean = tiersData.oceanCorrelations;
const themesWithData = ocean.themesWithData.filter(t => t.bestScore);
const themesWithoutData = ocean.themesWithData.filter(t => !t.bestScore);
---

<Base title="OCEAN Analysis | Pennyfarthing" description="Analysis of how Big Five personality traits correlate with benchmark performance across agent roles.">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-bold text-amber-100 mb-4">OCEAN Personality Analysis</h1>
    <p class="text-stone-300 mb-8">
      How Big Five personality traits correlate with benchmark performance.
      Based on job fair results (Jan 4-12, 2026).
    </p>

    <!-- OCEAN Overview -->
    <section class="bg-stone-800 border border-stone-700 rounded-lg p-6 mb-8">
      <h2 class="text-xl font-semibold text-amber-100 mb-4">The Big Five Traits</h2>
      <div class="grid gap-4 md:grid-cols-5">
        {Object.entries(traitColors).map(([trait, colors]) => (
          <div class="bg-stone-700/50 rounded-lg p-4 text-center">
            <div class={`text-3xl font-bold ${colors.text} mb-1`}>{trait}</div>
            <div class="text-stone-200 font-medium">{colors.label}</div>
            <div class="text-stone-500 text-xs mt-2">
              {trait === 'O' && 'Creativity, curiosity, openness to experience'}
              {trait === 'C' && 'Organization, diligence, self-discipline'}
              {trait === 'E' && 'Assertiveness, energy, sociability'}
              {trait === 'A' && 'Cooperation, trust, helpfulness'}
              {trait === 'N' && 'Emotional sensitivity, anxiety, moodiness'}
            </div>
          </div>
        ))}
      </div>
      <p class="text-stone-400 text-sm mt-4 text-center">
        Each trait is scored as <span class="text-green-400 font-mono">H</span> (High),
        <span class="text-yellow-400 font-mono">M</span> (Medium), or
        <span class="text-red-400 font-mono">L</span> (Low).
      </p>
    </section>

    <!-- Key Findings -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-amber-100 mb-6">Key Findings</h2>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Conscientiousness -->
        <div class="bg-stone-800 border border-stone-700 rounded-lg p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-blue-400">C</span>
            <div>
              <h3 class="text-lg font-semibold text-stone-200">{ocean.traitAnalysis.conscientiousness.title}</h3>
              <span class="text-xs text-stone-500">Conscientiousness</span>
            </div>
          </div>
          <p class="text-stone-400 text-sm mb-4">{ocean.traitAnalysis.conscientiousness.description}</p>
          <div class="flex flex-wrap gap-2">
            {ocean.traitAnalysis.conscientiousness.topThemes.map(theme => (
              <a href={getThemeLink(theme)} class="px-2 py-1 bg-blue-500/20 text-blue-300 rounded text-xs hover:bg-blue-500/30">
                {theme}
              </a>
            ))}
          </div>
        </div>

        <!-- Extraversion -->
        <div class="bg-stone-800 border border-stone-700 rounded-lg p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-green-400">E</span>
            <div>
              <h3 class="text-lg font-semibold text-stone-200">{ocean.traitAnalysis.extraversion.title}</h3>
              <span class="text-xs text-stone-500">Extraversion</span>
            </div>
          </div>
          <p class="text-stone-400 text-sm mb-4">{ocean.traitAnalysis.extraversion.description}</p>
          <div class="flex flex-wrap gap-2">
            {ocean.traitAnalysis.extraversion.topThemes.map(theme => (
              <a href={getThemeLink(theme)} class="px-2 py-1 bg-green-500/20 text-green-300 rounded text-xs hover:bg-green-500/30">
                {theme}
              </a>
            ))}
          </div>
        </div>

        <!-- Agreeableness -->
        <div class="bg-stone-800 border border-stone-700 rounded-lg p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-yellow-400">A</span>
            <div>
              <h3 class="text-lg font-semibold text-stone-200">{ocean.traitAnalysis.agreeableness.title}</h3>
              <span class="text-xs text-stone-500">Agreeableness</span>
            </div>
          </div>
          <p class="text-stone-400 text-sm mb-4">{ocean.traitAnalysis.agreeableness.description}</p>
          <div class="flex flex-wrap gap-2">
            {ocean.traitAnalysis.agreeableness.topThemes.map(theme => (
              <a href={getThemeLink(theme)} class="px-2 py-1 bg-yellow-500/20 text-yellow-300 rounded text-xs hover:bg-yellow-500/30">
                {theme}
              </a>
            ))}
          </div>
        </div>

        <!-- Neuroticism -->
        <div class="bg-stone-800 border border-stone-700 rounded-lg p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-red-400">N</span>
            <div>
              <h3 class="text-lg font-semibold text-stone-200">{ocean.traitAnalysis.neuroticism.title}</h3>
              <span class="text-xs text-stone-500">Neuroticism</span>
            </div>
          </div>
          <p class="text-stone-400 text-sm mb-4">{ocean.traitAnalysis.neuroticism.description}</p>
          <div class="flex flex-wrap gap-2">
            {ocean.traitAnalysis.neuroticism.topThemes.map(theme => (
              <a href={getThemeLink(theme)} class="px-2 py-1 bg-red-500/20 text-red-300 rounded text-xs hover:bg-red-500/30">
                {theme}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Openness note -->
      <div class="bg-stone-800/50 border border-stone-700 rounded-lg p-4 mt-6">
        <div class="flex items-center gap-3">
          <span class="text-2xl font-bold text-purple-400">O</span>
          <div>
            <h3 class="text-stone-200 font-medium">{ocean.traitAnalysis.openness.title}</h3>
            <p class="text-stone-500 text-sm">{ocean.traitAnalysis.openness.description}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Ideal Profiles by Role -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-amber-100 mb-6">Ideal OCEAN Profiles by Role</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {Object.entries(ocean.idealProfiles).map(([role, profile]) => (
          <div class="bg-stone-800 border border-stone-700 rounded-lg p-5">
            <h3 class="text-lg font-bold text-amber-200 uppercase mb-3">{role}</h3>
            <div class="flex gap-1 mb-3">
              <span class={`px-2 py-1 rounded text-xs font-mono border ${getLevelColor(profile.O)}`}>O:{profile.O}</span>
              <span class={`px-2 py-1 rounded text-xs font-mono border ${getLevelColor(profile.C)}`}>C:{profile.C}</span>
              <span class={`px-2 py-1 rounded text-xs font-mono border ${getLevelColor(profile.E)}`}>E:{profile.E}</span>
              <span class={`px-2 py-1 rounded text-xs font-mono border ${getLevelColor(profile.A)}`}>A:{profile.A}</span>
              <span class={`px-2 py-1 rounded text-xs font-mono border ${getLevelColor(profile.N)}`}>N:{profile.N}</span>
            </div>
            <p class="text-stone-400 text-sm">{profile.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Role-Based Recommendations -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-amber-100 mb-6">Theme Selection Guide</h2>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-stone-400 text-left border-b border-stone-700">
              <th class="pb-3 pr-4">If You Need...</th>
              <th class="pb-3 px-4">OCEAN Profile</th>
              <th class="pb-3 pl-4">Example Themes</th>
            </tr>
          </thead>
          <tbody>
            {ocean.roleRecommendations.map(rec => (
              <tr class="border-t border-stone-700/50">
                <td class="py-3 pr-4 font-medium text-stone-200">{rec.need}</td>
                <td class="py-3 px-4">
                  <span class="font-mono text-amber-300">{rec.profile}</span>
                </td>
                <td class="py-3 pl-4">
                  <div class="flex gap-2">
                    {rec.examples.map(theme => (
                      <a href={getThemeLink(theme)} class="text-stone-400 hover:text-amber-200">
                        {theme}
                      </a>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Themes with OCEAN + Benchmark Data -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-amber-100 mb-6">Themes with OCEAN + Benchmark Data</h2>
      <p class="text-stone-400 text-sm mb-4">
        {themesWithData.length} themes have both OCEAN profiles and benchmark results.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-stone-400 text-left border-b border-stone-700">
              <th class="pb-3 pr-4">Theme</th>
              <th class="pb-3 px-2 text-center">O</th>
              <th class="pb-3 px-2 text-center">C</th>
              <th class="pb-3 px-2 text-center">E</th>
              <th class="pb-3 px-2 text-center">A</th>
              <th class="pb-3 px-2 text-center">N</th>
              <th class="pb-3 px-4 text-right">Best Score</th>
              <th class="pb-3 px-4 text-right">Delta</th>
              <th class="pb-3 pl-4">Best Role</th>
            </tr>
          </thead>
          <tbody>
            {themesWithData.sort((a, b) => (b.bestDelta || 0) - (a.bestDelta || 0)).map(theme => (
              <tr class="border-t border-stone-700/50 hover:bg-stone-700/30">
                <td class="py-2 pr-4">
                  <a href={getThemeLink(theme.theme)} class="font-medium text-stone-200 hover:text-amber-200">
                    {theme.theme}
                  </a>
                </td>
                <td class="py-2 px-2 text-center">
                  <span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.O)}`}>{theme.O}</span>
                </td>
                <td class="py-2 px-2 text-center">
                  <span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.C)}`}>{theme.C}</span>
                </td>
                <td class="py-2 px-2 text-center">
                  <span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.E)}`}>{theme.E}</span>
                </td>
                <td class="py-2 px-2 text-center">
                  <span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.A)}`}>{theme.A}</span>
                </td>
                <td class="py-2 px-2 text-center">
                  <span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.N)}`}>{theme.N}</span>
                </td>
                <td class="py-2 px-4 text-right text-stone-300">{theme.bestScore?.toFixed(2)}</td>
                <td class="py-2 px-4 text-right text-green-400">+{theme.bestDelta?.toFixed(2)}</td>
                <td class="py-2 pl-4 text-stone-400">{theme.bestRole}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Themes with OCEAN but no benchmarks -->
    {themesWithoutData.length > 0 && (
      <section class="mb-10">
        <details class="bg-stone-800 border border-stone-700 rounded-lg">
          <summary class="p-4 cursor-pointer hover:bg-stone-700/50 flex items-center justify-between">
            <span class="text-stone-300">Themes with OCEAN profiles awaiting benchmarks ({themesWithoutData.length})</span>
            <span class="text-stone-500 text-sm">Click to expand</span>
          </summary>
          <div class="p-4 border-t border-stone-700">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-stone-500 text-left border-b border-stone-700">
                  <th class="pb-2">Theme</th>
                  <th class="pb-2 text-center">O</th>
                  <th class="pb-2 text-center">C</th>
                  <th class="pb-2 text-center">E</th>
                  <th class="pb-2 text-center">A</th>
                  <th class="pb-2 text-center">N</th>
                </tr>
              </thead>
              <tbody>
                {themesWithoutData.map(theme => (
                  <tr class="border-t border-stone-700/50">
                    <td class="py-2">
                      <a href={getThemeLink(theme.theme)} class="text-stone-400 hover:text-stone-300">
                        {theme.theme}
                      </a>
                    </td>
                    <td class="py-2 text-center"><span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.O)}`}>{theme.O}</span></td>
                    <td class="py-2 text-center"><span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.C)}`}>{theme.C}</span></td>
                    <td class="py-2 text-center"><span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.E)}`}>{theme.E}</span></td>
                    <td class="py-2 text-center"><span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.A)}`}>{theme.A}</span></td>
                    <td class="py-2 text-center"><span class={`px-2 py-0.5 rounded text-xs font-mono ${getLevelColor(theme.N)}`}>{theme.N}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </section>
    )}

    <!-- Summary -->
    <section class="bg-stone-800 border border-stone-700 rounded-lg p-6">
      <h2 class="text-xl font-semibold text-amber-100 mb-4">Summary</h2>
      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div>
          <div class="text-3xl font-bold text-blue-400">82%</div>
          <div class="text-stone-400 text-sm">Top performers have High C</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-green-400">E=L</div>
          <div class="text-stone-400 text-sm">Best for TEA role</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-yellow-400">A=L</div>
          <div class="text-stone-400 text-sm">Best for Reviewer role</div>
        </div>
      </div>
      <p class="text-stone-500 text-xs mt-4 text-center">
        Analysis based on job fair benchmark data. See <a href="/benchmarks" class="text-amber-500 hover:text-amber-400">Theme Tiers</a> for full performance rankings.
      </p>
    </section>
  </div>
</Base>
