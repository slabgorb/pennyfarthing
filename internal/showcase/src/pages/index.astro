---
/**
 * Home Page
 *
 * Landing page for the Pennyfarthing Showcase.
 * Emphasizes the scientific personality research aspect.
 */

import Base from '../layouts/Base.astro';
import { loadThemes } from '../lib/loader';

const themes = await loadThemes();
const totalAgents = themes.length * 10;

// Get a few featured themes for preview
const featuredThemes = themes.slice(0, 4);
---

<Base title="Pennyfarthing Showcase" description={`Scientific personality research: ${themes.length} themed AI personas with OCEAN profiles and benchmark data.`}>
  <div class="max-w-6xl mx-auto px-4">
    <!-- Hero Section -->
    <section class="hero text-center py-12">
      <img src="/pennyfarthing-reversed-transparent.png" alt="Pennyfarthing" class="h-24 w-24 mx-auto mb-6" />
      <h1 class="text-4xl font-bold text-amber-100 mb-4">Personality Research Showcase</h1>
      <p class="text-xl text-stone-300 mb-4 max-w-3xl mx-auto">
        How do strong personalities affect AI agent behavior?
      </p>
      <p class="text-lg text-stone-400 mb-8 max-w-3xl mx-auto">
        {themes.length} themed personas with OCEAN (Big Five) profiles, benchmark performance data,
        and statistical analysis of personality-performance correlations.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/benchmarks"
          class="inline-flex items-center px-8 py-4 bg-amber-600 text-stone-900 font-semibold rounded-lg hover:bg-amber-500 transition-colors text-lg"
        >
          View Research
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="/themes"
          class="inline-flex items-center px-8 py-4 bg-stone-700 text-stone-100 font-semibold rounded-lg hover:bg-stone-600 transition-colors text-lg"
        >
          Browse Themes
        </a>
      </div>
    </section>

    <!-- Research Focus Section -->
    <section class="research bg-stone-800/50 border border-stone-700 rounded-lg p-8 my-8">
      <h2 class="text-2xl font-bold text-amber-100 mb-4 text-center">The Research Question</h2>
      <p class="text-stone-300 text-center max-w-3xl mx-auto mb-6">
        Can OCEAN personality scores predict agent performance? We're testing hypotheses like:
        <em class="text-amber-400">Does High Openness detect more reasoning errors?</em> and
        <em class="text-amber-400">Does Low Agreeableness improve adversarial code review?</em>
      </p>
      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div>
          <div class="text-2xl font-bold text-amber-500">TRAIL</div>
          <div class="text-stone-400 text-sm">Error categorization framework</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-amber-500">OCEAN</div>
          <div class="text-stone-400 text-sm">Big Five personality profiles</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-amber-500">JobFair</div>
          <div class="text-stone-400 text-sm">Cross-role performance discovery</div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="stats grid grid-cols-2 md:grid-cols-4 gap-6 py-8 border-y border-stone-700">
      <div class="stat text-center">
        <div class="text-3xl font-bold text-amber-500">{themes.length}</div>
        <div class="text-stone-400">Themes</div>
      </div>
      <div class="stat text-center">
        <div class="text-3xl font-bold text-amber-500">{totalAgents}</div>
        <div class="text-stone-400">Characters</div>
      </div>
      <div class="stat text-center">
        <div class="text-3xl font-bold text-amber-500">10</div>
        <div class="text-stone-400">Agent Roles</div>
      </div>
      <div class="stat text-center">
        <div class="text-3xl font-bold text-amber-500">S-D</div>
        <div class="text-stone-400">Benchmark Tiers</div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features grid md:grid-cols-2 lg:grid-cols-4 gap-6 py-12">
      <a href="/benchmarks" class="feature-card bg-stone-800 border border-stone-700 rounded-lg p-6 hover:border-amber-600 transition-all">
        <div class="text-3xl mb-3">📊</div>
        <h2 class="text-lg font-semibold text-amber-100 mb-2">Benchmark Tiers</h2>
        <p class="text-stone-400 text-sm">Performance rankings with Cohen's d effect sizes</p>
      </a>

      <a href="/ocean" class="feature-card bg-stone-800 border border-stone-700 rounded-lg p-6 hover:border-amber-600 transition-all">
        <div class="text-3xl mb-3">🧠</div>
        <h2 class="text-lg font-semibold text-amber-100 mb-2">OCEAN Analysis</h2>
        <p class="text-stone-400 text-sm">Personality-performance correlations</p>
      </a>

      <a href="/compare" class="feature-card bg-stone-800 border border-stone-700 rounded-lg p-6 hover:border-amber-600 transition-all">
        <div class="text-3xl mb-3">⚖️</div>
        <h2 class="text-lg font-semibold text-amber-100 mb-2">Compare Profiles</h2>
        <p class="text-stone-400 text-sm">Side-by-side OCEAN comparisons</p>
      </a>

      <a href="/themes" class="feature-card bg-stone-800 border border-stone-700 rounded-lg p-6 hover:border-amber-600 transition-all">
        <div class="text-3xl mb-3">🎭</div>
        <h2 class="text-lg font-semibold text-amber-100 mb-2">Theme Gallery</h2>
        <p class="text-stone-400 text-sm">Browse all {themes.length} persona collections</p>
      </a>
    </section>

    <!-- Key Finding Callout -->
    <section class="finding bg-amber-900/20 border border-amber-700/50 rounded-lg p-6 my-8">
      <h3 class="text-lg font-semibold text-amber-100 mb-2">Early Finding</h3>
      <p class="text-stone-300">
        Character-specific expertise and natural fit for technical roles matter far more than abstract OCEAN scores.
        A scrappy street-smart character (Jesse Pinkman: 92.31) beats a philosopher king (Aristotle) at code review.
        <a href="/benchmarks" class="text-amber-400 hover:text-amber-300 ml-1">See the data →</a>
      </p>
    </section>

    <!-- Featured Themes Preview -->
    <section class="featured py-8">
      <h2 class="text-2xl font-bold text-amber-100 mb-6 text-center">Featured Themes</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredThemes.map((theme) => (
          <a
            href={`/themes/${theme.id}`}
            class="theme-preview bg-stone-800 border border-stone-700 rounded-lg p-4 hover:border-amber-600 transition-all text-center"
          >
            <h3 class="text-lg font-semibold text-amber-100 mb-1">{theme.metadata.name}</h3>
            <p class="text-sm text-stone-400 mb-2">{theme.metadata.source}</p>
            <p class="text-xs text-amber-500 italic">"{theme.metadata.userTitle}"</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-6">
        <a href="/themes" class="text-amber-500 hover:text-amber-400">
          View all {themes.length} themes →
        </a>
      </div>
    </section>
  </div>
</Base>
