---
/**
 * Theme Gallery Page
 *
 * Displays all 63+ themes in a table layout for perfect column alignment.
 * Each theme shows a spider chart thumbnail and character portraits.
 * Sticky header shows agent role labels aligned with portrait columns.
 */

import Base from '../../layouts/Base.astro';
import SpiderChart from '../../components/SpiderChart.astro';
import PortraitTooltip from '../../components/PortraitTooltip.astro';
import ThemeFilter from '../../components/ThemeFilter.tsx';
import { loadThemes } from '../../lib/loader';

// Load all themes at build time
const themes = await loadThemes();

// Extract unique source types for filter
const sourceTypes = [...new Set(themes.map((t) => t.metadata.source))].sort();

// Agent roles in display order
const roles = ['sm', 'tea', 'dev', 'reviewer', 'architect', 'pm', 'ux-designer', 'tech-writer', 'devops', 'orchestrator'];

// Human-readable role labels
const roleLabels: Record<string, string> = {
  'sm': 'SM',
  'tea': 'TEA',
  'dev': 'Dev',
  'reviewer': 'Review',
  'architect': 'Arch',
  'pm': 'PM',
  'ux-designer': 'UX',
  'tech-writer': 'Docs',
  'devops': 'Ops',
  'orchestrator': 'Orch',
};
---

<Base title="Theme Gallery | Pennyfarthing Showcase" description="Browse 63+ themed AI personas with OCEAN personality profiles and spider chart visualizations.">
  <div class="w-full px-4 md:px-6 lg:px-8">
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-amber-100 mb-2">Theme Gallery</h1>
      <p class="text-stone-300">
        Explore {themes.length} unique themes, each with 10 carefully crafted agent personas.
      </p>
    </header>

    <!-- Filter component (React island) -->
    <div class="mb-4">
      <ThemeFilter
        client:load
        sourceTypes={sourceTypes}
        onFilter={(filter) => {
          const rows = document.querySelectorAll('[data-theme-row]');
          const searchLower = filter.search.toLowerCase();

          rows.forEach((row) => {
            const name = row.getAttribute('data-theme-name')?.toLowerCase() ?? '';
            const source = row.getAttribute('data-theme-source') ?? '';

            const matchesSearch = !filter.search || name.includes(searchLower);
            const matchesSource =
              filter.sourceType.length === 0 || filter.sourceType.includes(source);

            (row as HTMLElement).style.display =
              matchesSearch && matchesSource ? 'table-row' : 'none';
          });
        }}
      />
    </div>

    <!-- Theme table -->
    <table class="theme-table w-full border-collapse">
      <thead class="sticky top-0 z-20 bg-[#272822]">
        <tr class="border-b border-stone-700">
          <th class="py-2 px-2 w-14"></th>
          <th class="py-2 px-2 text-left min-w-[140px]"></th>
          {roles.map((role) => (
            <th class="py-2 px-1 text-center">
              <span class="text-sm text-stone-400 font-medium uppercase tracking-wide">{roleLabels[role]}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {themes.map((theme) => (
          <tr
            data-theme-row
            data-theme-name={theme.metadata.name}
            data-theme-source={theme.metadata.source}
            class="theme-row border-b border-stone-700/30 hover:bg-stone-800/50 transition-colors"
          >
            <td class="py-2 px-2">
              <a href={`/themes/${theme.id}`} class="block">
                <SpiderChart agents={theme.agents} size={48} />
              </a>
            </td>
            <td class="py-2 px-2">
              <a href={`/themes/${theme.id}`} class="block">
                <div class="text-lg font-semibold text-amber-100 truncate max-w-[200px]">
                  {theme.metadata.name}
                </div>
                <div class="text-base text-stone-400 truncate max-w-[200px]">
                  {theme.metadata.source}
                </div>
              </a>
            </td>
            {roles.map((role) => {
              const agent = theme.agents.find((a) => a.role === role);
              const spritePath = agent ? `/sprites/${theme.id}/${agent.slug}.png` : `/sprites/${theme.id}/${role}.png`;
              const displayName = agent?.shortName || role;
              return (
                <td class="py-2 px-1 text-center align-top">
                  <div class="flex flex-col items-center h-full">
                    {agent ? (
                      <PortraitTooltip agent={agent} themeName={theme.metadata.name} themeId={theme.id}>
                        <a href={`/characters/${theme.id}/${role}`} class="block">
                          <img
                            src={spritePath}
                            alt={agent.character}
                            class="w-10 h-10 mx-auto rounded bg-stone-700 hover:ring-2 hover:ring-amber-500 transition-all object-cover"
                            loading="lazy"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                          />
                          <div class="w-10 h-10 mx-auto rounded bg-stone-700 items-center justify-center text-lg hidden">
                            {agent.emoji || '👤'}
                          </div>
                        </a>
                      </PortraitTooltip>
                    ) : (
                      <a href={`/characters/${theme.id}/${role}`} class="block" title={role}>
                        <img
                          src={spritePath}
                          alt={role}
                          class="w-10 h-10 mx-auto rounded bg-stone-700 hover:ring-2 hover:ring-amber-500 transition-all object-cover"
                          loading="lazy"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        />
                        <div class="w-10 h-10 mx-auto rounded bg-stone-700 items-center justify-center text-lg hidden">
                          👤
                        </div>
                      </a>
                    )}
                    <span class="portrait-name text-xs text-stone-500 mt-1 text-center leading-tight max-w-[70px] h-8 flex items-start justify-center">{displayName}</span>
                  </div>
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-12 text-stone-400">
      <p>No themes match your filters.</p>
      <p class="text-sm mt-2">Try adjusting your search or filter criteria.</p>
    </div>
  </div>
</Base>

<script>
  // Show/hide empty state based on visible rows
  function updateEmptyState() {
    const rows = document.querySelectorAll('[data-theme-row]');
    const visibleRows = Array.from(rows).filter(
      (row) => (row as HTMLElement).style.display !== 'none'
    );
    const emptyState = document.getElementById('empty-state');

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleRows.length > 0);
    }
  }

  // Watch for filter changes
  const observer = new MutationObserver(updateEmptyState);
  document.querySelectorAll('[data-theme-row]').forEach((row) => {
    observer.observe(row, { attributes: true, attributeFilter: ['style'] });
  });
</script>
