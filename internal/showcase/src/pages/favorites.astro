---
/**
 * Favorites Page
 *
 * Displays characters saved to localStorage favorites.
 * Uses FavoritesGrid React island for client-side rendering.
 */
import Base from '../layouts/Base.astro';
import FavoritesGrid from '../components/FavoritesGrid';
import { loadThemes } from '../lib/loader';

// Load all themes and flatten to characters (same pattern as compare.astro)
const themesData = await loadThemes();

const characters = themesData.flatMap(theme =>
  Object.values(theme.agents).map((agent) => ({
    theme: theme.metadata.name,
    role: agent.role,
    name: agent.character,
    ocean: agent.ocean,
  }))
);

const title = 'Favorites | Pennyfarthing Showcase';
const description = 'Your saved favorite AI personas from the Pennyfarthing collection.';
---

<Base title={title} description={description}>
  <div class="max-w-7xl mx-auto">
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-[var(--text-primary)] mb-2">Favorites</h1>
      <p class="text-[var(--text-secondary)]">
        Your saved characters. Click to select for comparison.
      </p>
    </header>

    <FavoritesGrid
      client:load
      allCharacters={characters}
    />
  </div>
</Base>
