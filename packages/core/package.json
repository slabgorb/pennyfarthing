{
  "name": "@pennyfarthing/core",
  "version": "12.7.0",
  "description": "Claude Code agent framework with TDD workflow and persona system",
  "type": "module",
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "ai",
    "tdd",
    "workflow",
    "anthropic"
  ],
  "license": "UNLICENSED",
  "author": "1898andCo",
  "repository": {
    "type": "git",
    "url": "https://github.com/1898andCo/pennyfarthing.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/1898andCo/pennyfarthing#readme",
  "bugs": {
    "url": "https://github.com/1898andCo/pennyfarthing/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "pennyfarthing-dist/agents/",
    "pennyfarthing-dist/commands/",
    "pennyfarthing-dist/guides/",
    "pennyfarthing-dist/output-styles/",
    "pennyfarthing-dist/personas/themes/",
    "pennyfarthing-dist/personas/portraits/",
    "pennyfarthing-dist/scripts/",
    "pennyfarthing-dist/skills/",
    "pennyfarthing-dist/templates/",
    "pennyfarthing-dist/workflows/",
    "pennyfarthing-dist/pf/",
    "src/public/"
  ],
  "scripts": {
    "build": "tsc && npm run build:react",
    "build:tsc": "tsc",
    "build:react": "vite build",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "eslint src/",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.12",
    "open": "^11.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3",
    "vite": "^7.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
