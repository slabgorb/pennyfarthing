{
  "name": "@pennyfarthing/vscode-extension",
  "displayName": "Pennyfarthing",
  "description": "VS Code extension for Pennyfarthing - agent orchestration for Claude Code",
  "version": "0.0.1",
  "publisher": "1898andco",
  "private": true,
  "type": "module",
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/1898andCo/pennyfarthing.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/1898andCo/pennyfarthing#readme",
  "bugs": {
    "url": "https://github.com/1898andCo/pennyfarthing/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.pennyfarthing",
    "workspaceContains:.claude"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pennyfarthing.showStatus",
        "title": "Pennyfarthing: Show Status"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "package": "vsce package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pennyfarthing/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.2",
    "vitest": "^4.0.16"
  }
}
