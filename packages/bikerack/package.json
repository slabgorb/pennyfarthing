{
  "name": "@pennyfarthing/bikerack",
  "version": "0.0.1",
  "description": "BikeRack session observer and data infrastructure for Pennyfarthing",
  "type": "module",
  "license": "UNLICENSED",
  "author": "1898andCo",
  "repository": {
    "type": "git",
