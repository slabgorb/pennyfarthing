{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@pennyfarthing/core": ["../core/src/index.ts"],
      "@pennyfarthing/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "src/preload.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../shared" }
  ]
}
