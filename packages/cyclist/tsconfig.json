{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "types": ["node", "electron"],
    "paths": {
      "@pennyfarthing/core": ["../core/src/index.ts"],
      "@pennyfarthing/core/server": ["../core/src/server/server.ts"],
      "@pennyfarthing/core/dist/server/api/*": ["../core/src/server/api/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "src/public/**/*.tsx", "src/public/**/*.ts", "src/public/styles/**"],
  "references": [
    { "path": "../core" }
  ]
}
