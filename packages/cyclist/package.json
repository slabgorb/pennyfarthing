{
  "name": "@pennyfarthing/cyclist",
  "version": "1.0.0",
  "description": "Desktop application for running Claude Code with visual terminal interface",
  "author": "1898andCo",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && concurrently -k -n tsc,preload,electron -c blue,cyan,green \"tsc --watch --preserveWatchOutput\" \"tsc -p tsconfig.preload.json --watch --preserveWatchOutput\" \"electron .\"",
    "dev:once": "npm run build && electron .",
    "dev:web": "CYCLIST_DEV_WEB=1 CYCLIST_PROJECT_DIR=${CYCLIST_PROJECT_DIR:-$PWD} tsx watch src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc && tsc -p tsconfig.preload.json && npm run build:editor",
    "build:editor": "esbuild src/editor-bundle.ts --bundle --format=iife --global-name=TipTap --outfile=src/public/js/tiptap.bundle.js",
    "build:electron": "npm run build && electron-builder",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-rebuild",
    "install:app": "./scripts/install-app.sh",
    "install:cli": "./scripts/install-cli.sh",
    "install:all": "npm run install:app && npm run install:cli"
  },
  "dependencies": {
    "@pennyfarthing/shared": "workspace:*",
    "@tiptap/core": "^2.27.1",
    "@tiptap/extension-code-block": "^2.27.1",
    "@tiptap/starter-kit": "^2.27.1",
    "express": "^4.18.2",
    "node-pty": "^1.1.0",
    "ws": "^8.14.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^24.9.1",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.0.11",
    "supertest": "^6.3.3",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^4.0.16"
  },
  "build": {
    "appId": "com.cyclist.app",
    "productName": "Cyclist",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/public/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/pennyfarthing/showcase/**"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
