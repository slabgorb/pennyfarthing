{
  "name": "@pennyfarthing/cyclist",
  "version": "12.7.0",
  "description": "Visual terminal interface for Claude Code - React GUI",
  "author": "1898andCo",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/1898andCo/pennyfarthing.git",
    "directory": "packages/cyclist"
  },
  "homepage": "https://github.com/1898andCo/pennyfarthing#readme",
  "bugs": {
    "url": "https://github.com/1898andCo/pennyfarthing/issues"
  },
  "files": [
    "dist/",
    "src/public/",
    "portraits/"
  ],
  "scripts": {
    "dev:vite": "vite --config vite.config.ts",
    "lint": "eslint src/",
    "build": "npm run build:commands && npm run build:react",
    "build:react": "vite build",
    "build:commands": "node scripts/generate-slash-commands.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:trace": "playwright show-trace",
    "prepack": "./scripts/copy-portraits.sh",
    "install:app": "./scripts/install-app.sh",
    "install:cli": "./scripts/install-cli.sh",
    "install:all": "npm run install:app && npm run install:cli"
  },
  "dependencies": {
    "@pennyfarthing/core": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.24",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
