{
  "name": "@pennyfarthing/cyclist",
  "version": "7.5.0",
  "description": "Visual terminal interface for Claude Code",
  "author": "1898andCo",
  "type": "module",
  "main": "dist/server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/1898andCo/pennyfarthing.git",
    "directory": "packages/cyclist"
  },
  "homepage": "https://github.com/1898andCo/pennyfarthing#readme",
  "bugs": {
    "url": "https://github.com/1898andCo/pennyfarthing/issues"
  },
  "files": [
    "dist/",
    "src/public/",
    "portraits/"
  ],
  "scripts": {
    "dev": "npm run build && concurrently -k -n tsc,preload,electron -c blue,cyan,green \"tsc --watch --preserveWatchOutput\" \"tsc -p tsconfig.preload.json --watch --preserveWatchOutput\" \"electron dist/main.js\"",
    "dev:once": "npm run build && electron dist/main.js",
    "dev:web": "CYCLIST_DEV_WEB=1 CYCLIST_PROJECT_DIR=${CYCLIST_PROJECT_DIR:-$PWD} tsx watch src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:debug": "CYCLIST_DEV_WEB=1 OTEL_DEBUG=true CYCLIST_PROJECT_DIR=${CYCLIST_PROJECT_DIR:-$PWD} node --inspect src/server.ts",
    "dev:debug-brk": "CYCLIST_DEV_WEB=1 OTEL_DEBUG=true CYCLIST_PROJECT_DIR=${CYCLIST_PROJECT_DIR:-$PWD} node --inspect-brk src/server.ts",
    "dev:electron-debug": "npm run build && concurrently -k -n tsc,preload,electron -c blue,cyan,green \"tsc --watch --preserveWatchOutput\" \"tsc -p tsconfig.preload.json --watch --preserveWatchOutput\" \"electron --inspect=9229 dist/main.js\"",
    "build": "npm run build:commands && tsc --build && tsc -p tsconfig.preload.json && npm run build:editor",
    "build:commands": "node scripts/generate-slash-commands.js",
    "build:editor": "esbuild src/editor-bundle.ts --bundle --format=iife --global-name=TipTap --outfile=src/public/js/tiptap.bundle.js",
    "build:electron": "npm run build && electron-builder -c.npmRebuild=false",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:trace": "playwright show-trace",
    "prepack": "./scripts/copy-portraits.sh",
    "install:app": "./scripts/install-app.sh",
    "install:cli": "./scripts/install-cli.sh",
    "install:all": "npm run install:app && npm run install:cli"
  },
  "dependencies": {
    "@pennyfarthing/core": "workspace:*",
    "@pennyfarthing/shared": "workspace:*",
    "@tiptap/core": "^2.27.1",
    "@tiptap/extension-code-block": "^2.27.1",
    "@tiptap/starter-kit": "^2.27.1",
    "electron-window-state": "^5.0.3",
    "express": "^4.18.2",
    "node-pty": "^1.1.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.58.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.17",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^24.9.1",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.4.0",
    "supertest": "^6.3.3",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^4.0.16"
  },
  "build": {
    "appId": "com.cyclist.app",
    "productName": "Cyclist",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/public/**/*",
      "portraits/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/pennyfarthing/showcase/**"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "extraResources": [
      {
        "from": "../../pennyfarthing-dist/personas/portraits",
        "to": "pennyfarthing-dist/personas/portraits",
        "filter": [
          "**/*",
          "!**/original/**",
          "!**/small/**"
        ]
      },
      {
        "from": "../../pennyfarthing-dist/personas/themes",
        "to": "pennyfarthing-dist/personas/themes"
      },
      {
        "from": "../../pennyfarthing-dist/agents",
        "to": "pennyfarthing-dist/agents"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
