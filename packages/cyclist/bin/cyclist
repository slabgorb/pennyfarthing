#!/bin/bash
# Cyclist CLI - launch Cyclist in a directory
# Usage: cyclist [path]

set -e

PROJECT_DIR="$PWD"
if [ -n "$1" ]; then
  PROJECT_DIR="$1"
  # Convert to absolute path if relative
  [[ ! "$PROJECT_DIR" = /* ]] && PROJECT_DIR="$PWD/$PROJECT_DIR"
fi

if [ ! -d "$PROJECT_DIR" ]; then
  echo "Error: Directory does not exist: $PROJECT_DIR" >&2
  exit 1
fi

# Resolve to canonical path (follow symlinks, remove ..)
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"

open -a Cyclist --args --project-dir="$PROJECT_DIR"
