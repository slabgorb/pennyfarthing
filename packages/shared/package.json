{
  "name": "@pennyfarthing/shared",
  "version": "11.3.7",
  "description": "Shared utilities for Pennyfarthing including portrait path resolution",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && cp src/*.sh dist/ 2>/dev/null || true",
    "lint": "eslint src/",
    "test": "node --test dist/*.test.js",
    "clean": "rm -rf dist/"
  },
  "keywords": [
    "pennyfarthing",
    "shared",
    "portrait-resolver"
  ],
  "license": "UNLICENSED",
  "author": "1898andCo",
  "repository": {
    "type": "git",
    "url": "https://github.com/1898andCo/pennyfarthing.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
