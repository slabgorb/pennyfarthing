{
  "name": "@pennyfarthing/core",
  "version": "12.5.0",
  "description": "Claude Code agent framework with TDD workflow and persona system",
  "type": "module",
  "main": "./packages/core/dist/index.js",
  "types": "./packages/core/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "default": "./packages/core/dist/index.js"
    },
    "./server": {
      "types": "./packages/core/dist/server/server.d.ts",
      "default": "./packages/core/dist/server/server.js"
    },
    "./bikerack/server": {
      "types": "./packages/core/dist/server/server.d.ts",
      "default": "./packages/core/dist/server/server.js"
    },
    "./bikerack/entry": {
      "types": "./packages/core/dist/server/entry.d.ts",
      "default": "./packages/core/dist/server/entry.js"
    },
    "./dist/*": "./packages/core/dist/*"
  },
  "files": [
    "packages/core/dist/",
    "packages/core/src/public/",
    "pennyfarthing-dist/agents/",
    "pennyfarthing-dist/commands/",
    "pennyfarthing-dist/gates/",
    "pennyfarthing-dist/guides/",
    "pennyfarthing-dist/output-styles/",
    "pennyfarthing-dist/personas/themes/",
    "pennyfarthing-dist/personas/portraits/",
    "pennyfarthing-dist/scripts/",
    "pennyfarthing-dist/skills/",
    "pennyfarthing-dist/templates/",
    "pennyfarthing-dist/workflows/",
    "pennyfarthing-dist/src/pf/",
    "pennyfarthing-dist/pyproject.toml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1898andCo/pennyfarthing.git"
  },
  "homepage": "https://github.com/1898andCo/pennyfarthing#readme",
  "bugs": {
    "url": "https://github.com/1898andCo/pennyfarthing/issues"
  },
  "scripts": {
    "prepublishOnly": "find pennyfarthing-dist/scripts -name '*.sh' ! -name 'find-root.sh' -exec chmod +x {} + && ./tests/unit/test_package_contents.sh && ./pennyfarthing-dist/scripts/git/changelog-links.sh --validate",
    "build": "pnpm --filter @pennyfarthing/core run build:tsc && pnpm --filter @pennyfarthing/core run build:react && pnpm --filter @pennyfarthing/cyclist build && ./scripts/generate-skill-docs.sh",
    "docs": "./scripts/generate-skill-docs.sh",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "eslint 'packages/*/src/**/*.ts' --max-warnings 0",
    "lint:md": "markdownlint-cli2 'pennyfarthing-dist/**/*.md'",
    "validate:refs": "node scripts/validate-refs.js",
    "test:validate-refs": "node --test scripts/validate-refs.test.js",
    "clean": "pnpm -r clean"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.12",
    "open": "^11.0.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview-react": "^4.13.1",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "lucide-react": "^0.563.0",
    "markdownlint-cli2": "^0.21.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "minimatch": ">=9.0.7",
      "rollup@>=4.0.0 <5": ">=4.59.0",
      "ajv@<7": "~6.14.0",
      "qs@>=6.7.0 <7": ">=6.14.2"
    },
    "packageExtensions": {
      "dockview": {
        "peerDependencies": {
          "react-dom": "*"
        }
      }
    }
  }
}
