{
  "name": "pennyfarthing-monorepo",
  "version": "6.3.0",
  "private": true,
  "description": "Claude Code agent framework monorepo",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/1898andCo/pennyfarthing.git"
  },
  "homepage": "https://github.com/1898andCo/pennyfarthing#readme",
  "bugs": {
    "url": "https://github.com/1898andCo/pennyfarthing/issues"
  },
  "scripts": {
    "build": "pnpm -r build && ./scripts/utils/generate-skill-docs.sh",
    "docs": "./scripts/utils/generate-skill-docs.sh",
