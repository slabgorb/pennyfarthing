{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pennyfarthing.dev/schemas/skill-registry.schema.json",
  "title": "Pennyfarthing Skill Registry",
  "description": "Schema for the centralized skill metadata registry",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the registry format"
    },
    "skills": {
      "type": "object",
      "description": "Map of skill names to their metadata",
      "additionalProperties": {
        "$ref": "#/definitions/skill"
      }
    }
  },
  "required": ["version", "skills"],
  "additionalProperties": false,
  "definitions": {
    "skill": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Canonical name of the skill (matches directory name)"
        },
        "description": {
          "type": "string",
          "description": "Brief description for discovery and help text"
        },
        "category": {
          "type": "string",
          "enum": [
            "development",
            "project-management",
            "theming",
            "tools",
            "ai-llm",
            "documentation",
            "benchmarking"
          ],
          "description": "Primary category for grouping skills"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Searchable tags for discovery"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Skill version (semantic versioning)"
        },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other skills or tools required before using this skill"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "context": {
                "type": "string",
                "description": "When to use this invocation"
              },
              "invocation": {
                "type": "string",
                "description": "How to invoke the skill"
              }
            },
            "required": ["context", "invocation"],
            "additionalProperties": false
          },
          "description": "Example invocations with context"
        },
        "anti_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Common mistakes or misuses to avoid"
        },
        "related_skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skills that complement or relate to this one"
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional searchable terms for discovery"
        },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools this skill is allowed to use. If omitted, all tools are allowed. Use to restrict read-only skills from writing."
        },
        "deprecated": {
          "type": "boolean",
          "description": "Whether this skill is deprecated"
        },
        "redirect": {
          "type": "string",
          "description": "Skill name to redirect to when deprecated"
        },
        "command_group": {
          "type": "string",
          "description": "Command group name from command-registry.yaml that this skill manages"
        }
      },
      "required": ["name", "description", "category", "tags"],
      "additionalProperties": false
    }
  }
}
