# Include source package (includes src/pf/_dist/ symlinks which resolve to content)
graft src

# Include project files
include pyproject.toml
include README.md
include LICENSE

# Exclude top-level content directories (content is included via src/pf/_dist/ symlinks)
prune agents
prune templates
prune guides
prune personas
prune workflows
prune scripts
prune skills
prune commands
prune output-styles
prune gates
prune packages
prune tests
prune docs

# Portraits ship via the R2 CDN (pf.package.portrait_cdn) + git-LFS, NOT the
# wheel. graft src follows the src/pf/_dist/personas symlink and would otherwise
# pull ~190MB of portraits in; exclude them here (and in pyproject package-data).
recursive-exclude src/pf/_dist/personas/portraits *
global-exclude *.png *.jpg *.jpeg *.webp

# Exclude test files from package
prune src/pf/tests

# Exclude build artifacts and caches
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.pem
global-exclude *.egg-info
