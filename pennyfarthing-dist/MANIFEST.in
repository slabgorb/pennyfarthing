# Include source package (includes src/pf/_dist/ symlinks which resolve to content)
graft src

# Include project files
include pyproject.toml
include README.md
include LICENSE

# Exclude top-level content directories (content is included via src/pf/_dist/ symlinks)
prune agents
prune templates
prune guides
prune personas
prune workflows
prune scripts
prune skills
prune commands
prune output-styles
prune gates
prune packages
prune tests
prune docs

# Exclude large binary content from bundled _dist
prune src/pf/_dist/personas/spiders

# Exclude test files from package
prune src/pf/tests

# Exclude build artifacts and caches
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.pem
global-exclude *.egg-info
