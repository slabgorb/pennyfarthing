# Pennyfarthing Agent Scope Configuration
# Defines what context each agent loads on activation

# Strategic Agents - Full project scope
strategic_agents:

  orchestrator:
    description: "Master orchestrator - sees everything"
    scope: full
    context_files:
      - sprint/current-sprint.yaml
      - .claude/project/docs/shared-context.md
      - .session/current-work.md

  pm:
    description: "Product Manager - strategic planning"
    scope: full
    context_files:
      - sprint/current-sprint.yaml
      - .claude/project/docs/shared-context.md
      - .session/current-work.md

  sm:
    description: "Scrum Master - story coordination"
    scope: full
    context_files:
      - sprint/current-sprint.yaml
      - .claude/project/docs/shared-context.md
      - .session/current-work.md

  architect:
    description: "System Architect - technical design"
    scope: full
    context_files:
      - .claude/project/docs/shared-context.md
      - .session/current-work.md

  devops:
    description: "DevOps Engineer - infrastructure"
    scope: infrastructure
    context_files:
      - sprint/current-sprint.yaml
      - .claude/project/docs/shared-context.md
      - .session/current-work.md

# Tactical Agents - Story-scoped
