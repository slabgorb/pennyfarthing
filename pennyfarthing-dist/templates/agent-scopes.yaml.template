  tea:
    description: "Test Engineer - writes tests"
    scope: story
    context_files:
      - sprint/current-sprint.yaml
      - .session/current-work.md
      - .claude/project/docs/shared-context.md

  reviewer:
    description: "Code Reviewer - reviews changes"
    scope: story
    context_files:
      - sprint/current-sprint.yaml
      - .session/current-work.md
      - .claude/project/docs/shared-context.md

  tech-writer:
    description: "Technical Writer - documentation"
    scope: story
    context_files:
      - sprint/current-sprint.yaml
      - .session/current-work.md
      - .claude/project/docs/shared-context.md

  ux-designer:
    description: "UX Designer - user experience"
    scope: story
    context_files:
      - sprint/current-sprint.yaml
      - .session/current-work.md
      - .claude/project/docs/shared-context.md

# Context Loading Rules
context_loading:
  strategic_agents:
    - Load all context_files on activation
    - Know entire project scope

  tactical_agents:
    - Load base context_files on activation
    - Focus on specific story or task
