{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash",
      "Edit(.claude/**)",
      "Edit(sprint/**)",
      "Edit(.session/**)",
      "Write(.claude/**)",
      "Write(sprint/**)",
      "Write(.session/**)",
      "Skill(sm)",
      "Skill(tea)",
      "Skill(dev)",
      "Skill(reviewer)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/project/hooks/setup-env.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/pennyfarthing/statusline.sh"
  }
}
