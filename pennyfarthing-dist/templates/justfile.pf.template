# Pennyfarthing framework recipes — auto-generated by pf init
# DO NOT EDIT — overwritten on every pf init
# Add project recipes to ./justfile instead
#
# Requires `root := justfile_directory()` in the parent justfile.

# Start WheelHub server (API + WebSocket)
# Usage: just wheelhub [start|stop|status]
wheelhub *args:
    #!/usr/bin/env bash
    set -euo pipefail
    subcmd="{{args}}"
    case "${subcmd:-start}" in
        start)  pf launch gui --no-open ;;
        stop)   pf launch stop ;;
        status) pf launch status ;;
        *)      echo "Usage: just wheelhub [start|stop|status]"; exit 1 ;;
    esac

# Launch TUI panel viewer (starts WheelHub if needed)
tui:
    pf launch tui --foreground

# Launch GUI dashboard in browser (starts WheelHub if needed)
gui:
    pf launch gui

# Launch Claude with OTEL pre-configured for WheelHub/BikeRack
claude:
    #!/usr/bin/env bash
    set -euo pipefail

    project_dir="{{root}}"
    PORT=""

    # Check .cyclist-port first, then .bikerack-port
    for port_file in "$project_dir/.cyclist-port" "$project_dir/.bikerack-port"; do
        if [[ -f "$port_file" ]]; then
            candidate=$(cat "$port_file" 2>/dev/null)
            if [[ "$candidate" =~ ^[0-9]+$ ]]; then
                if (echo >/dev/tcp/localhost/"$candidate") 2>/dev/null; then
                    PORT="$candidate"
                    break
                fi
            fi
        fi
    done

    if [[ -n "$PORT" ]]; then
        echo "[just claude] OTEL configured → http://localhost:$PORT" >&2
        export CLAUDE_CODE_ENABLE_TELEMETRY="1"
        export OTEL_EXPORTER_OTLP_PROTOCOL="http/json"
        export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:$PORT"
        export OTEL_LOGS_EXPORTER="otlp"
        export OTEL_METRICS_EXPORTER="otlp"
    else
        echo "[just claude] No WheelHub/BikeRack running — launching without OTEL" >&2
        echo "[just claude] Start one first: just wheelhub start" >&2
    fi

    exec claude

# Launch tmux dev layout (Claude + TUI in split panes)
tmux-dev:
    exec "{{root}}/tmux-dev"

# Launch tmux dev layout for a specific directory
tmux dir=invocation_directory():
    "{{root}}/tmux-dev" "{{dir}}"
