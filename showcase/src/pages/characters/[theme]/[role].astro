---
/**
 * Character Profile Page
 *
 * Dynamic route for individual character pages.
 * Displays full character details, OCEAN visualization,
 * related characters, and favorite button.
 *
 * Route: /characters/[theme]/[role]
 * Generates 640 pages (64 themes × 10 roles)
 */

import Base from '../../../layouts/Base.astro';
import SpiderChart from '../../../components/SpiderChart.astro';
import OceanBadge from '../../../components/OceanBadge.astro';
import RelatedCharacters from '../../../components/RelatedCharacters.astro';
import FavoriteButton from '../../../components/FavoriteButton.astro';
import { loadThemes } from '../../../lib/loader';
import type { Theme, Agent } from '../../../lib/types';

export async function getStaticPaths() {
  const themes = await loadThemes();

  // Generate paths for all theme/role combinations
  const paths = themes.flatMap((theme) =>
    theme.agents.map((agent) => ({
      params: { theme: theme.id, role: agent.role },
      props: { theme, agent, allThemes: themes },
    }))
  );

  return paths;
}

interface Props {
  theme: Theme;
  agent: Agent;
  allThemes: Theme[];
}

const { theme, agent, allThemes } = Astro.props;

// Generate "Best For" recommendations based on OCEAN scores
function getBestForRecommendations(ocean: typeof agent.ocean): string[] {
  const recommendations: string[] = [];

  if (ocean.O >= 4) recommendations.push('Creative tasks, exploration, new technologies');
  if (ocean.C >= 4) recommendations.push('Planning, documentation, code review');
  if (ocean.E >= 4) recommendations.push('Team coordination, presentations, pair programming');
  if (ocean.A >= 4) recommendations.push('Conflict resolution, mentoring, support');
  if (ocean.N <= 2) recommendations.push('High-pressure situations, production issues');

  return recommendations.length > 0 ? recommendations : ['General development tasks'];
}

const bestFor = getBestForRecommendations(agent.ocean);
---

<Base
  title={`${agent.character} | ${theme.metadata.name} | Pennyfarthing`}
  description={`${agent.character} - ${agent.style}`}
>
  <div class="character-profile max-w-4xl mx-auto px-4 py-8">
    <!-- Character Header -->
    <header class="profile-header text-center mb-8">
      <div class="emoji text-8xl mb-4">{agent.emoji || '👤'}</div>
      <h1 class="character text-3xl font-bold text-gray-900 mb-2">
        {agent.character}
      </h1>
      <div class="role-badge inline-block px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm font-medium uppercase mb-2">
        {agent.role}
      </div>
      <p class="theme-link text-sm text-gray-500">
        from <a href={`/themes/${theme.id}`} class="text-indigo-600 hover:text-indigo-800">{theme.metadata.name}</a>
      </p>
    </header>

    <!-- OCEAN Visualization Section -->
    <section class="ocean-section grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
      <div class="spider-container bg-white rounded-lg shadow-md p-6 flex flex-col items-center">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Personality Profile</h2>
        <SpiderChart agents={[agent]} size={200} showLabels={true} />
      </div>
      <div class="bars-container bg-white rounded-lg shadow-md p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">OCEAN Scores</h2>
        <OceanBadge ocean={agent.ocean} />
      </div>
    </section>

    <!-- Character Details Section -->
    <section class="details-section bg-white rounded-lg shadow-md p-6 mb-8">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Character Details</h2>

      <div class="detail-grid grid gap-4">
        <div class="detail-item">
          <span class="label text-sm font-medium text-gray-500">Style:</span>
          <p class="value text-gray-900">{agent.style}</p>
        </div>

        <div class="detail-item">
          <span class="label text-sm font-medium text-gray-500">Expertise:</span>
          <p class="value text-gray-900">{agent.expertise}</p>
        </div>

        <div class="detail-item">
          <span class="label text-sm font-medium text-gray-500">Quote:</span>
          <p class="value text-gray-900 italic">"{agent.quote}"</p>
        </div>

        <div class="detail-item">
          <span class="label text-sm font-medium text-gray-500">Trait:</span>
          <p class="value text-gray-900">{agent.trait}</p>
        </div>
      </div>
    </section>

    <!-- Personality Expression Section -->
    <section class="expression-section bg-white rounded-lg shadow-md p-6 mb-8">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Personality Expression</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {agent.catchphrases && agent.catchphrases.length > 0 && (
          <div class="catchphrases">
            <h3 class="text-sm font-medium text-gray-500 mb-2">Catchphrases:</h3>
            <ul class="list-disc list-inside text-gray-900">
              {agent.catchphrases.map((phrase) => (
                <li class="text-sm">{phrase}</li>
              ))}
            </ul>
          </div>
        )}

        {agent.quirks && agent.quirks.length > 0 && (
          <div class="quirks">
            <h3 class="text-sm font-medium text-gray-500 mb-2">Quirks:</h3>
            <ul class="list-disc list-inside text-gray-900">
              {agent.quirks.map((quirk) => (
                <li class="text-sm">{quirk}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <!-- Helper Info Section -->
    {agent.helper && agent.helper.name && (
      <section class="helper-section bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Helper</h2>
        <div class="helper-info">
          <span class="helper-name font-medium text-gray-900">{agent.helper.name}</span>
          {agent.helper.style && (
            <p class="helper-style text-sm text-gray-600 mt-1">{agent.helper.style}</p>
          )}
        </div>
      </section>
    )}

    <!-- Best For Section -->
    <section class="best-for-section bg-indigo-50 rounded-lg p-6 mb-8">
      <h2 class="text-lg font-semibold text-indigo-900 mb-4">Best For</h2>
      <ul class="list-disc list-inside text-indigo-800">
        {bestFor.map((rec) => (
          <li class="text-sm">{rec}</li>
        ))}
      </ul>
    </section>

    <!-- Related Characters Section -->
    <div class="related-section bg-white rounded-lg shadow-md p-6 mb-8">
      <RelatedCharacters
        role={agent.role}
        currentTheme={theme.id}
        themes={allThemes}
      />
    </div>

    <!-- Favorite Button -->
    <div class="favorite-section text-center mb-8">
      <FavoriteButton themeId={theme.id} role={agent.role} />
    </div>

    <!-- Navigation -->
    <div class="navigation flex justify-between items-center pt-6 border-t border-gray-200">
      <a href={`/themes/${theme.id}`} class="text-indigo-600 hover:text-indigo-800 text-sm">
        &larr; Back to {theme.metadata.name}
      </a>
      <a href="/themes" class="text-indigo-600 hover:text-indigo-800 text-sm">
        All Themes
      </a>
    </div>
  </div>
</Base>
