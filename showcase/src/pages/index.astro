---
import Base from '../layouts/Base.astro';
import TestReactIsland from '../components/TestReactIsland';
---

<Base title="Pennyfarthing Showcase" description="Browse 64 themed AI personas with OCEAN personality profiles, spider charts, and Chernoff faces.">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold text-[var(--text-primary)] mb-4">Pennyfarthing Showcase</h1>
    <p class="text-[var(--text-secondary)] mb-8">
      Explore 64 themed AI agent personas with OCEAN personality profiles,
      interactive spider charts, and Chernoff faces.
    </p>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <!-- Theme cards will be added in story 13-4 -->
      <div class="bg-[var(--bg-card)] rounded-lg border border-[var(--border-color)] p-6">
        <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-2">Coming Soon</h2>
        <p class="text-[var(--text-secondary)]">Theme gallery and persona browser</p>
      </div>
    </div>

    <!-- React Island Test (from story 13-1) -->
    <div class="mt-8">
      <TestReactIsland client:load />
    </div>
  </div>
</Base>
