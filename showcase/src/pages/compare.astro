---
/**
 * Compare Page
 *
 * Interactive character comparison using the QueryBuilder React island.
 * Allows filtering by OCEAN dimensions, roles, themes, and custom expressions.
 */
import Base from '../layouts/Base.astro';
import QueryBuilder from '../components/QueryBuilder';
import { loadThemes } from '../data/loader';

// Load all themes and flatten to characters
const themesData = await loadThemes();
const themes = themesData.map(t => t.metadata.name);

// Flatten all characters from all themes
const characters = themesData.flatMap(theme =>
  Object.entries(theme.agents).map(([role, agent]) => ({
    theme: theme.metadata.name,
    role,
    name: agent.character,
    ocean: agent.ocean,
  }))
);

const title = 'Compare Characters | Pennyfarthing Showcase';
const description = 'Compare AI personas across 64 themes using OCEAN personality filters, role selection, and custom queries.';
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Compare Characters</h1>
      <p class="text-gray-600">
        Filter and compare {characters.length} characters across {themes.length} themes
        using OCEAN personality dimensions.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Query Builder (React Island) -->
      <div class="lg:col-span-1">
        <QueryBuilder
          client:load
          themes={themes}
          characters={characters}
        />
      </div>

      <!-- Results Area -->
      <div class="lg:col-span-2">
        <div id="results-container" class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Results</h2>
          <p class="text-gray-500" id="results-placeholder">
            Use the filters to search characters. Results will appear here.
          </p>
          <div id="results-grid" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Results will be populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  // Handle results from QueryBuilder
  document.addEventListener('astro:page-load', () => {
    const resultsGrid = document.getElementById('results-grid');
    const placeholder = document.getElementById('results-placeholder');

    // This will be connected when QueryBuilder emits results
    // For now, placeholder logic
    if (resultsGrid && placeholder) {
      // QueryBuilder will handle results via onResults prop
    }
  });
</script>
