---
/**
 * Compare Page
 *
 * Interactive character comparison using the QueryBuilder React island.
 * Allows filtering by OCEAN dimensions, roles, themes, and custom expressions.
 */
import Base from '../layouts/Base.astro';
import QueryBuilder from '../components/QueryBuilder';
import { loadThemes } from '../lib/loader';

// Load all themes and flatten to characters
const themesData = await loadThemes();
const themes = themesData.map(t => t.metadata.name);

// Flatten all characters from all themes
const characters = themesData.flatMap(theme =>
  Object.values(theme.agents).map((agent) => ({
    theme: theme.metadata.name,
    role: agent.role,
    name: agent.character,
    ocean: agent.ocean,
  }))
);

const title = 'Compare Characters | Pennyfarthing Showcase';
const description = 'Compare AI personas across 64 themes using OCEAN personality filters, role selection, and custom queries.';
---

<Base title={title} description={description}>
  <div class="max-w-7xl mx-auto">
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-[var(--text-primary)] mb-2">Compare Characters</h1>
      <p class="text-[var(--text-secondary)]">
        Filter and compare {characters.length} characters across {themes.length} themes
        using OCEAN personality dimensions.
      </p>
    </header>

    <QueryBuilder
      client:load
      themes={themes}
      characters={characters}
    />
  </div>
</Base>
