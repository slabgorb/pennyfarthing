---
/**
 * Theme Gallery Page
 *
 * Displays all 63+ themes in a filterable, scrollable list.
 * Each theme shows a spider chart thumbnail and character portraits.
 * Sticky header shows agent role labels aligned with portrait columns.
 */

import Base from '../../layouts/Base.astro';
import ThemeRow from '../../components/ThemeRow.astro';
import ThemeFilter from '../../components/ThemeFilter.tsx';
import { loadThemes } from '../../lib/loader';

// Load all themes at build time
const themes = await loadThemes();

// Extract unique source types for filter
const sourceTypes = [...new Set(themes.map((t) => t.metadata.source))].sort();

// Agent roles in display order (matches ThemeRow)
const roles = ['sm', 'tea', 'dev', 'reviewer', 'architect', 'pm', 'ux-designer', 'tech-writer', 'devops', 'orchestrator'];

// Human-readable role labels
const roleLabels: Record<string, string> = {
  'sm': 'SM',
  'tea': 'TEA',
  'dev': 'Dev',
  'reviewer': 'Review',
  'architect': 'Arch',
  'pm': 'PM',
  'ux-designer': 'UX',
  'tech-writer': 'Docs',
  'devops': 'Ops',
  'orchestrator': 'Orch',
};
---

<Base title="Theme Gallery | Pennyfarthing Showcase" description="Browse 63+ themed AI personas with OCEAN personality profiles and spider chart visualizations.">
  <div class="w-full px-4 md:px-6 lg:px-8">
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-amber-100 mb-2">Theme Gallery</h1>
      <p class="text-stone-300">
        Explore {themes.length} unique themes, each with 10 carefully crafted agent personas.
      </p>
    </header>

    <!-- Filter component (React island) -->
    <div class="mb-4">
      <ThemeFilter
        client:load
        sourceTypes={sourceTypes}
        onFilter={(filter) => {
          const cards = document.querySelectorAll('[data-theme-card]');
          const searchLower = filter.search.toLowerCase();

          cards.forEach((card) => {
            const name = card.getAttribute('data-theme-name')?.toLowerCase() ?? '';
            const source = card.getAttribute('data-theme-source') ?? '';

            const matchesSearch = !filter.search || name.includes(searchLower);
            const matchesSource =
              filter.sourceType.length === 0 || filter.sourceType.includes(source);

            (card as HTMLElement).style.display =
              matchesSearch && matchesSource ? 'flex' : 'none';
          });
        }}
      />
    </div>

    <!-- Sticky header with role labels -->
    <div class="sticky top-0 z-20 bg-[#272822] border-b border-stone-700 py-2 mb-2">
      <div class="theme-row-layout">
        <div class="theme-row-spider"></div>
        <div class="theme-row-info"></div>
        <div class="theme-row-portraits">
          {roles.map((role) => (
            <div class="portrait-cell text-center">
              <span class="text-xs text-stone-400 font-medium uppercase tracking-wide">{roleLabels[role]}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Theme list -->
    <div class="theme-list flex flex-col gap-2">
      {themes.map((theme) => (
        <div
          data-theme-card
          data-theme-name={theme.metadata.name}
          data-theme-source={theme.metadata.source}
          class="flex"
        >
          <ThemeRow theme={theme} />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-12 text-stone-400">
      <p>No themes match your filters.</p>
      <p class="text-sm mt-2">Try adjusting your search or filter criteria.</p>
    </div>
  </div>
</Base>

<script>
  // Show/hide empty state based on visible cards
  function updateEmptyState() {
    const cards = document.querySelectorAll('[data-theme-card]');
    const visibleCards = Array.from(cards).filter(
      (card) => (card as HTMLElement).style.display !== 'none'
    );
    const emptyState = document.getElementById('empty-state');

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCards.length > 0);
    }
  }

  // Watch for filter changes
  const observer = new MutationObserver(updateEmptyState);
  document.querySelectorAll('[data-theme-card]').forEach((card) => {
    observer.observe(card, { attributes: true, attributeFilter: ['style'] });
  });
</script>
