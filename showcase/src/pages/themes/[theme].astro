---
/**
 * Theme Detail Page
 *
 * Dynamic route for individual theme pages.
 * Shows theme info, team spider chart, and all 10 agents.
 */

import Base from '../../layouts/Base.astro';
import SpiderChart from '../../components/SpiderChart.astro';
import AgentGrid from '../../components/AgentGrid.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import { loadThemes } from '../../lib/loader';
import type { Theme } from '../../lib/types';

export async function getStaticPaths() {
  const themes = await loadThemes();
  return themes.map((theme) => ({
    params: { theme: theme.id },
    props: { theme },
  }));
}

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
---

<Base title={`${theme.metadata.name} | Pennyfarthing Themes`} description={theme.metadata.description}>
  <div class="theme-detail max-w-6xl mx-auto px-4 py-8">
    <!-- Theme Header -->
    <header class="theme-header text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        {theme.metadata.name}
      </h1>
      <p class="text-lg text-gray-600 mb-2">
        {theme.metadata.description}
      </p>
      <p class="text-sm text-indigo-600 font-medium">
        Source: {theme.metadata.source}
      </p>
      {theme.metadata.userTitle && (
        <p class="text-sm text-gray-500 italic mt-2">
          Address users as: "{theme.metadata.userTitle}"
        </p>
      )}
    </header>

    <!-- Team Spider Chart -->
    <section class="team-spider flex flex-col items-center mb-10">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Team Personality Profile</h2>
      <div class="spider-container bg-white rounded-lg shadow-md p-6">
        <SpiderChart agents={theme.agents} size={300} showLabels={true} />
      </div>
      <p class="text-sm text-gray-500 mt-2">
        Averaged OCEAN scores across all {theme.agents.length} agents
      </p>
    </section>

    <!-- Agent Grid -->
    <section class="agents-section mb-10">
      <h2 class="text-xl font-semibold text-gray-800 mb-4 text-center">
        The Team ({theme.agents.length} Agents)
      </h2>
      <AgentGrid>
        {theme.agents.map((agent) => (
          <ProfileCard agent={agent} themeId={theme.id} />
        ))}
      </AgentGrid>
    </section>

    <!-- Compare Button -->
    <section class="compare-section text-center">
      <a
        href={`/compare?themes=${theme.id}`}
        class="inline-flex items-center px-6 py-3 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition-colors"
      >
        Compare this team
        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </section>

    <!-- Back link -->
    <div class="mt-8 text-center">
      <a href="/themes" class="text-indigo-600 hover:text-indigo-800 text-sm">
        &larr; Back to all themes
      </a>
    </div>
  </div>
</Base>
