---
/**
 * ThemeCard Component
 *
 * Wide horizontal theme card for the gallery view.
 * Shows theme info on left, character portraits in a row on right.
 * Entire card is clickable.
 */

import type { Theme } from '../lib/types';
import SpiderChart from './SpiderChart.astro';
import PortraitTooltip from './PortraitTooltip.astro';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

// Agent roles in display order
const roles = ['sm', 'tea', 'dev', 'reviewer', 'architect', 'pm', 'ux-designer', 'tech-writer', 'devops', 'orchestrator'];
---

<div class="theme-card bg-stone-800 border border-stone-700 rounded-lg shadow-md hover:shadow-lg hover:border-amber-600 transition-all p-4 flex items-center gap-4 relative overflow-visible">
  <!-- Clickable overlay for theme link (excluding portraits) -->
  <a
    href={`/themes/${theme.id}`}
    class="absolute inset-0 z-0"
    aria-label={`View ${theme.metadata.name} theme`}
  ></a>

  <!-- Spider chart thumbnail -->
  <div class="spider-thumbnail flex-shrink-0 z-10 pointer-events-none">
    <SpiderChart agents={theme.agents} size={64} />
  </div>

  <!-- Theme info -->
  <div class="flex-shrink-0 min-w-0 w-48 z-10 pointer-events-none">
    <h3 class="text-lg font-semibold text-amber-100 truncate">
      {theme.metadata.name}
    </h3>
    <p class="source text-sm text-stone-400 truncate">
      {theme.metadata.source}
    </p>
    {theme.metadata.userTitle && (
      <p class="user-title text-xs text-amber-500 italic truncate mt-1">
        "{theme.metadata.userTitle}"
      </p>
    )}
  </div>

  <!-- Character portraits row -->
  <div class="portraits flex gap-1 flex-grow justify-end z-10">
    {roles.map((role) => {
      const agent = theme.agents.find((a) => a.role === role);
      const spritePath = `/sprites/${theme.id}/${role}.png`;
      return agent ? (
        <PortraitTooltip agent={agent} themeName={theme.metadata.name} themeId={theme.id}>
          <a href={`/characters/${theme.id}/${role}`} class="portrait-container flex-shrink-0 block">
            <img
              src={spritePath}
              alt={agent.character}
              class="w-[50px] h-[50px] rounded object-cover bg-stone-700 hover:ring-2 hover:ring-amber-500 transition-all"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="w-[50px] h-[50px] rounded bg-stone-700 items-center justify-center text-2xl hidden">
              {agent.emoji || '👤'}
            </div>
          </a>
        </PortraitTooltip>
      ) : (
        <a href={`/characters/${theme.id}/${role}`} class="portrait-container flex-shrink-0 block" title={role}>
          <img
            src={spritePath}
            alt={role}
            class="w-[50px] h-[50px] rounded object-cover bg-stone-700 hover:ring-2 hover:ring-amber-500 transition-all"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="w-[50px] h-[50px] rounded bg-stone-700 items-center justify-center text-2xl hidden">
            👤
          </div>
        </a>
      );
    })}
  </div>
</div>
