---
/**
 * ThemeCard Component
 *
 * Individual theme card for the gallery view.
 * Shows theme name, source, spider chart, and character preview.
 * Entire card is clickable.
 */

import type { Theme } from '../lib/types';
import SpiderChart from './SpiderChart.astro';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

// Find specific agents for preview
const sm = theme.agents.find((a) => a.role === 'sm');
const dev = theme.agents.find((a) => a.role === 'dev');
const reviewer = theme.agents.find((a) => a.role === 'reviewer');
---

<a
  href={`/themes/${theme.id}`}
  class="theme-card bg-stone-800 border border-stone-700 rounded-lg shadow-md hover:shadow-lg hover:border-amber-600 transition-all p-4 flex flex-col cursor-pointer"
>
  <!-- Spider chart thumbnail -->
  <div class="spider-thumbnail flex justify-center mb-3">
    <SpiderChart agents={theme.agents} size={80} />
  </div>

  <!-- Theme name -->
  <h3 class="text-lg font-semibold text-amber-100 text-center mb-1">
    {theme.metadata.name}
  </h3>

  <!-- Source type -->
  <p class="source text-sm text-stone-400 text-center mb-2">
    {theme.metadata.source}
  </p>

  <!-- User title flavor text -->
  {theme.metadata.userTitle && (
    <p class="user-title text-xs text-amber-500 italic text-center mb-3">
      "{theme.metadata.userTitle}"
    </p>
  )}

  <!-- Character preview -->
  <div class="preview text-xs text-stone-300 border-t border-stone-700 pt-2 mt-auto space-y-1">
    {sm && (
      <p>
        <span class="font-medium text-stone-400">SM:</span> {sm.character}
      </p>
    )}
    {dev && (
      <p>
        <span class="font-medium text-stone-400">Dev:</span> {dev.character}
      </p>
    )}
    {reviewer && (
      <p>
        <span class="font-medium text-stone-400">Reviewer:</span> {reviewer.character}
      </p>
    )}
  </div>
</a>
