---
/**
 * SpiderChart Component
 *
 * SVG radar/spider chart for OCEAN personality visualization.
 * Displays averaged OCEAN scores across agents as a polygon.
 */

import type { Agent, OceanScores } from '../lib/types';

interface Props {
  agents: Agent[];
  size?: number;
  showLabels?: boolean;
  className?: string;
}

const { agents, size = 80, showLabels = false, className = '' } = Astro.props;

// Calculate average OCEAN scores across all agents
function calculateAverageOcean(agents: Agent[]): OceanScores {
  if (agents.length === 0) {
    return { O: 3, C: 3, E: 3, A: 3, N: 3 };
  }

  const sum = agents.reduce(
    (acc, agent) => ({
      O: acc.O + agent.ocean.O,
      C: acc.C + agent.ocean.C,
      E: acc.E + agent.ocean.E,
      A: acc.A + agent.ocean.A,
      N: acc.N + agent.ocean.N,
    }),
    { O: 0, C: 0, E: 0, A: 0, N: 0 }
  );

  const count = agents.length;
  return {
    O: sum.O / count,
    C: sum.C / count,
    E: sum.E / count,
    A: sum.A / count,
    N: sum.N / count,
  };
}

// Convert OCEAN scores to polygon points
function oceanToPolygonPoints(ocean: OceanScores, size: number): string {
  const center = size / 2;
  const maxRadius = (size / 2) * 0.8; // 80% of half-size for padding

  // 5 axes at 72° intervals (360/5), starting from top
  const dimensions: (keyof OceanScores)[] = ['O', 'C', 'E', 'A', 'N'];

  const points = dimensions.map((dim, i) => {
    const angle = (i * 72 - 90) * (Math.PI / 180); // Start from top (-90°)
    const score = ocean[dim];
    const radius = (score / 5) * maxRadius; // Normalize 1-5 to 0-maxRadius

    const x = center + radius * Math.cos(angle);
    const y = center + radius * Math.sin(angle);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });

  return points.join(' ');
}

// Generate grid lines for visual reference
function generateGridLines(size: number): string[] {
  const center = size / 2;
  const maxRadius = (size / 2) * 0.8;
  const lines: string[] = [];

  // Create concentric pentagons for score levels 1-5
  for (let level = 1; level <= 5; level++) {
    const radius = (level / 5) * maxRadius;
    const points = [0, 1, 2, 3, 4].map((i) => {
      const angle = (i * 72 - 90) * (Math.PI / 180);
      const x = center + radius * Math.cos(angle);
      const y = center + radius * Math.sin(angle);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    });
    lines.push(points.join(' '));
  }

  return lines;
}

// Generate axis lines from center to each vertex
function generateAxisLines(size: number): Array<{ x1: number; y1: number; x2: number; y2: number }> {
  const center = size / 2;
  const maxRadius = (size / 2) * 0.8;

  return [0, 1, 2, 3, 4].map((i) => {
    const angle = (i * 72 - 90) * (Math.PI / 180);
    return {
      x1: center,
      y1: center,
      x2: center + maxRadius * Math.cos(angle),
      y2: center + maxRadius * Math.sin(angle),
    };
  });
}

// Generate label positions for OCEAN dimensions
function generateLabelPositions(size: number): Array<{ x: number; y: number; label: string }> {
  const center = size / 2;
  const labelRadius = (size / 2) * 0.95;
  const dimensions: (keyof OceanScores)[] = ['O', 'C', 'E', 'A', 'N'];

  return dimensions.map((dim, i) => {
    const angle = (i * 72 - 90) * (Math.PI / 180);
    return {
      x: center + labelRadius * Math.cos(angle),
      y: center + labelRadius * Math.sin(angle),
      label: dim,
    };
  });
}

const averageOcean = calculateAverageOcean(agents);
const polygonPoints = oceanToPolygonPoints(averageOcean, size);
const gridLines = generateGridLines(size);
const axisLines = generateAxisLines(size);
const labelPositions = generateLabelPositions(size);
---

<svg
  width={size}
  height={size}
  viewBox={`0 0 ${size} ${size}`}
  class={`spider-chart ${className}`}
  aria-label="OCEAN personality spider chart"
>
  <!-- Background grid pentagons -->
  {gridLines.map((points, i) => (
    <polygon
      points={points}
      fill="none"
      stroke="currentColor"
      stroke-width="0.5"
      class="text-gray-300"
      opacity={0.3 + i * 0.1}
    />
  ))}

  <!-- Axis lines -->
  {axisLines.map((line) => (
    <line
      x1={line.x1}
      y1={line.y1}
      x2={line.x2}
      y2={line.y2}
      stroke="currentColor"
      stroke-width="0.5"
      class="text-gray-300"
    />
  ))}

  <!-- Data polygon -->
  <polygon
    points={polygonPoints}
    fill="currentColor"
    fill-opacity="0.3"
    stroke="currentColor"
    stroke-width="2"
    class="text-indigo-600"
  />

  <!-- Labels (optional) -->
  {showLabels && labelPositions.map((pos) => (
    <text
      x={pos.x}
      y={pos.y}
      text-anchor="middle"
      dominant-baseline="middle"
      class="text-xs font-medium text-gray-600"
      fill="currentColor"
    >
      {pos.label}
    </text>
  ))}
</svg>
