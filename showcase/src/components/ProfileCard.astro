---
/**
 * ProfileCard Component
 *
 * Individual agent card for theme detail view.
 * Shows agent emoji/face, character name, spider chart, quote,
 * and links to the full profile page.
 */

import type { Agent } from '../lib/types';
import SpiderChart from './SpiderChart.astro';

interface Props {
  agent: Agent;
  themeId: string;
}

const { agent, themeId } = Astro.props;
---

<a
  href={`/characters/${themeId}/${agent.role}`}
  class="profile-card bg-white rounded-lg shadow-md hover:shadow-lg transition-all p-4 flex flex-col items-center text-center group"
>
  <!-- Agent emoji/face placeholder -->
  <div class="face text-4xl mb-2">
    {agent.emoji || '👤'}
  </div>

  <!-- Character name -->
  <h4 class="character text-sm font-semibold text-gray-900 mb-1 group-hover:text-indigo-600">
    {agent.character}
  </h4>

  <!-- Role label -->
  <p class="role text-xs text-gray-500 uppercase tracking-wide mb-2">
    {agent.role}
  </p>

  <!-- Individual spider chart -->
  <div class="spider mb-2">
    <SpiderChart agents={[agent]} size={60} />
  </div>

  <!-- Quote -->
  <p class="quote text-xs text-gray-600 italic line-clamp-2">
    "{agent.quote}"
  </p>
</a>
