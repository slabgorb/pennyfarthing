---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-800 text-gray-300 mt-auto">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <!-- Project Info -->
      <div class="text-center md:text-left">
        <p class="font-semibold text-white">Pennyfarthing</p>
        <p class="text-sm">AI Agent Orchestration Framework</p>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-6">
        <a
          href="https://github.com/1898andCo/pennyfarthing"
          class="text-gray-300 hover:text-white transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <a
          href="https://github.com/1898andCo/pennyfarthing#readme"
          class="text-gray-300 hover:text-white transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          Docs
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-6 pt-6 border-t border-gray-700 text-center text-sm">
      <p>&copy; {currentYear} 1898 & Co. All rights reserved.</p>
    </div>
  </div>
</footer>
