---
import MobileMenu from './MobileMenu.tsx';

const navLinks = [
  { href: '/themes', label: 'Themes' },
  { href: '/compare', label: 'Compare' },
  { href: '/benchmarks', label: 'Benchmarks' },
  { href: '/favorites', label: 'Favorites' },
];
---

<header class="bg-stone-950 border-b border-stone-800">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo / Site Title -->
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
        <img src="/pennyfarthing-reversed-transparent.png" alt="Pennyfarthing" class="h-8 w-8" />
        <span class="text-2xl font-bold text-amber-500">Pennyfarthing</span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-6">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class="text-stone-300 hover:text-amber-500 font-medium transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu -->
      <div class="md:hidden">
        <MobileMenu client:load navLinks={navLinks} />
      </div>
    </div>
  </nav>
</header>
