---
import MobileMenu from './MobileMenu.tsx';

const navLinks = [
  { href: '/themes', label: 'Themes' },
  { href: '/compare', label: 'Compare' },
  { href: '/benchmarks', label: 'Benchmarks' },
  { href: '/favorites', label: 'Favorites' },
];
---

<header class="bg-[var(--bg-darker)] border-b border-[var(--border-color)]">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo / Site Title -->
      <a href="/" class="flex items-center gap-2 !text-[var(--accent-green)] hover:!text-[var(--accent-yellow)]">
        <span class="text-2xl font-bold">Pennyfarthing</span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-6">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class="!text-[var(--text-secondary)] hover:!text-[var(--text-primary)] font-medium transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu -->
      <div class="md:hidden">
        <MobileMenu client:load navLinks={navLinks} />
      </div>
    </div>
  </nav>
</header>
