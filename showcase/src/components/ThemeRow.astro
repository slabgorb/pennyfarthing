---
/**
 * ThemeRow Component
 *
 * Full-width horizontal theme row for the gallery view.
 * Uses CSS Grid for consistent alignment with header.
 * Shows theme info on left, character portraits in aligned columns on right.
 */

import type { Theme } from '../lib/types';
import SpiderChart from './SpiderChart.astro';
import PortraitTooltip from './PortraitTooltip.astro';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

// Agent roles in display order (must match index.astro header)
const roles = ['sm', 'tea', 'dev', 'reviewer', 'architect', 'pm', 'ux-designer', 'tech-writer', 'devops', 'orchestrator'];
---

<div class="theme-row bg-stone-800/50 hover:bg-stone-800 border border-stone-700/50 hover:border-amber-600/50 rounded-lg transition-all relative">
  <!-- Clickable overlay for theme link (excluding portraits) -->
  <a
    href={`/themes/${theme.id}`}
    class="absolute inset-0 z-0"
    aria-label={`View ${theme.metadata.name} theme`}
  ></a>

  <div class="theme-row-layout py-3 px-4">
    <!-- Spider chart thumbnail -->
    <div class="theme-row-spider flex items-center justify-center z-10 pointer-events-none">
      <SpiderChart agents={theme.agents} size={48} />
    </div>

    <!-- Theme info -->
    <div class="theme-row-info flex flex-col justify-center min-w-0 z-10 pointer-events-none">
      <h3 class="text-base font-semibold text-amber-100 truncate">
        {theme.metadata.name}
      </h3>
      <p class="text-sm text-stone-400 truncate">
        {theme.metadata.source}
      </p>
    </div>

    <!-- Character portraits row -->
    <div class="theme-row-portraits z-10">
      {roles.map((role) => {
        const agent = theme.agents.find((a) => a.role === role);
        const spritePath = `/sprites/${theme.id}/${role}.png`;
        const characterName = agent?.character?.split(' ')[0] || role;
        return (
          <div class="portrait-cell">
            {agent ? (
              <PortraitTooltip agent={agent} themeName={theme.metadata.name} themeId={theme.id}>
                <a href={`/characters/${theme.id}/${role}`} class="block">
                  <img
                    src={spritePath}
                    alt={agent.character}
                    class="rounded bg-stone-700 hover:ring-2 hover:ring-amber-500 transition-all"
                    loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="rounded bg-stone-700 items-center justify-center text-lg hidden aspect-square">
                    {agent.emoji || '👤'}
                  </div>
                </a>
              </PortraitTooltip>
            ) : (
              <a href={`/characters/${theme.id}/${role}`} class="block" title={role}>
                <img
                  src={spritePath}
                  alt={role}
                  class="rounded bg-stone-700 hover:ring-2 hover:ring-amber-500 transition-all"
                  loading="lazy"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="rounded bg-stone-700 items-center justify-center text-lg hidden aspect-square">
                  👤
                </div>
              </a>
            )}
            <span class="portrait-name">{characterName}</span>
          </div>
        );
      })}
    </div>
  </div>
</div>

