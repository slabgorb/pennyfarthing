---
/**
 * RelatedCharacters Component
 *
 * Shows characters with the same role across different themes.
 * Excludes the current character and displays in a horizontal scroll layout.
 */

import type { Theme, Agent } from '../lib/types';
import SpiderChart from './SpiderChart.astro';

interface Props {
  role: string;
  currentTheme: string;
  themes: Theme[];
  maxItems?: number;
}

const { role, currentTheme, themes, maxItems = 6 } = Astro.props;

// Filter to find agents with the same role from other themes
const relatedCharacters = themes
  .filter((theme) => theme.id !== currentTheme)
  .map((theme) => {
    const agent = theme.agents.find((a) => a.role === role);
    if (!agent) return null;
    return { theme, agent };
  })
  .filter((item): item is { theme: Theme; agent: Agent } => item !== null)
  .slice(0, maxItems);
---

<section class="related-characters">
  <h3 class="text-lg font-semibold text-gray-800 mb-4">
    Related Characters
    <span class="text-sm font-normal text-gray-500 ml-2">
      (Same role, different themes)
    </span>
  </h3>

  {relatedCharacters.length > 0 ? (
    <div class="scroll-container overflow-x-auto pb-4">
      <div class="flex gap-4" style="min-width: max-content;">
        {relatedCharacters.map(({ theme, agent }) => (
          <a
            href={`/characters/${theme.id}/${agent.role}`}
            class="related-card flex-shrink-0 w-48 bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow p-4 text-center group"
          >
            <div class="emoji text-3xl mb-2">{agent.emoji || '👤'}</div>
            <h4 class="character text-sm font-semibold text-gray-900 group-hover:text-indigo-600 truncate">
              {agent.character}
            </h4>
            <p class="theme-name text-xs text-gray-500 truncate mb-2">
              {theme.metadata.name}
            </p>
            <div class="spider flex justify-center">
              <SpiderChart agents={[agent]} size={60} />
            </div>
          </a>
        ))}
      </div>
    </div>
  ) : (
    <p class="text-sm text-gray-500 italic">
      No related characters found for this role.
    </p>
  )}
</section>
