---
/**
 * ThemeGrid Component
 *
 * Responsive grid container for theme cards.
 * Uses Tailwind CSS for mobile-first responsive layout.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'theme-grid',
    'grid',
    'grid-cols-1',
    'sm:grid-cols-2',
    'lg:grid-cols-4',
    'xl:grid-cols-6',
    'gap-6',
    className,
  ]}
>
  <slot />
</div>
