---
/**
 * FavoriteButton Component
 *
 * Placeholder button for adding characters to favorites.
 * Actual localStorage functionality will be added in story 13-12.
 */

interface Props {
  themeId: string;
  role: string;
  className?: string;
}

const { themeId, role, className = '' } = Astro.props;
---

<button
  type="button"
  class={`favorite-button inline-flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 hover:border-indigo-300 transition-colors ${className}`}
  data-theme={themeId}
  data-role={role}
  aria-label="Add to favorites"
>
  <span class="heart text-lg">♡</span>
  <span class="label text-sm font-medium">Add to Favorites</span>
</button>
