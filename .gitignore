# OS files
.DS_Store
*.swp
*~

# IDE
.idea/
.vscode/
*.code-workspace

# Claude Code (managed at orchestrator level, not framework)
.claude/

# Root package.json is an orchestrator artifact
/package.json

# Node.js / npm
node_modules/
*.tgz
.npm/
npm-debug.log*

# TypeScript
*.tsbuildinfo

# Build output (delivered via npm)
dist/
build/

# Redundant copy - root pennyfarthing-dist/ is included via package.json files field
packages/core/pennyfarthing-dist/

# TypeScript build output in source directories (misplaced builds)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Exception: frontend JS source files are not TypeScript output
!packages/*/src/public/**/*.js

# Package lock (project uses pnpm - ignore npm lockfile)
package-lock.json

# Benchmark scratch files
.scratch/
cart/
benchmarks/cart/
go.mod

# Benchmark results (live in orchestrator repo, not framework)
internal/

# Test output files
*-test-output.txt
test-output.txt
__test_*__/

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# VS Code extension builds
*.vsix
packages/vscode-extension/resources/portraits/

# Git worktrees
worktrees/

# Frame runtime state (when running locally for development)
.frame-port
.frame-pid
.pennyfarthing/
.env
uv.lock


# Pennyfarthing runtime
.session/*
!.session/.gitkeep
pennyfarthing-dist/src/.session/
.claude/settings.local.json
.claude/persona-config.local.yaml
.pennyfarthing/config.local.yaml

# Runtime state files (Cyclist, bells, etc)
*.pid
*-pid
*-port
.pennyfarthing/*.json
.cyclist-*

# Model checkpoints
checkpoints/
# Frame server runtime files
frame-pid
tui-pid
# Local pf shim (machine-specific absolute paths)
.pennyfarthing/bin/
# tmux runtime cache files
.pennyfarthing/tmux-status
.pennyfarthing/tmux-status-left
.pennyfarthing/tmux-status-right
.pennyfarthing/tmux-activity
# Local tmux config (copied from sample)
tmux.conf
